{
  "manifest_version": 3,
  "name": "Duyên AI - Pancake",
  "version": "2026.9.8.2",
  "description": "Tra cứu lịch sử khách hàng & gợi ý trả lời AI trên Pancake (POS/Chat) và Messenger.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.pancake.vn/*",
    "*://pancake.vn/*",
    "*://*.pages.fm/*",
    "*://*.messenger.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "pancake-background.js"
  },
  "action": {
    "default_popup": "pancake-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "pancake-options.html",
  "content_scripts": [
    {
      "matches": ["*://*.pancake.vn/*", "*://pancake.vn/*", "*://*.pages.fm/*"],
      "js": ["pancake-content.js"],
      "css": ["pancake-content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.messenger.com/*"],
      "js": ["pancake-content.js"],
      "css": ["pancake-content.css"],
      "run_at": "document_idle"
    }
  ]
}
