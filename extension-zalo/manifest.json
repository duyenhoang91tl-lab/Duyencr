{
  "manifest_version": 3,
  "name": "Duyên AI - Zalo",
  "version": "2026.9.8.1",
  "description": "Tra cứu lịch sử khách hàng & gợi ý trả lời AI trên Zalo (chat.zalo.me).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "clipboardWrite", "activeTab", "scripting"],
  "host_permissions": [
    "https://chat.zalo.me/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "action": {
    "default_popup": "zalo-popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "zalo-options.html",
  "content_scripts": [
    {
      "matches": ["https://chat.zalo.me/*"],
      "js": ["zalo-content.js"],
      "run_at": "document_idle"
    }
  ]
}
